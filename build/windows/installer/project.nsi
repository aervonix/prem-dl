Unicode true

####
## Prem-dl's installer. It carries the bundled build (yt-dlp and ffmpeg inside the exe; see
## bundle.go) and installs it for the current user, without an admin prompt, which matches the
## per-user entries the app writes itself (prem-dl: links, starting with Windows).
##
## Built by scripts/release.ps1, which runs: wails build -tags bundled -nsis
##
## Template replacements don't work in this file; "wails_tools.nsh" (regenerated by every
## `wails build`) fills in whatever isn't defined here from wails.json. To work on the installer
## without Wails, make one nsis build first, then:
## > makensis -DARG_WAILS_AMD64_BINARY=..\..\bin\Prem-dl.exe project.nsi
####
!define REQUEST_EXECUTION_LEVEL "user"
!define WAILS_INSTALL_SCOPE "user"
# Otherwise "${INFO_COMPANYNAME}${INFO_PRODUCTNAME}", and Wails fills an empty company name with
# the product's: "Prem-dlPrem-dl".
!define UNINST_KEY_NAME "Prem-dl"

!include "wails_tools.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"

# "1" when the app started this installer to update itself (app_update.go):
#   Prem-dl-Setup.exe /update /D=<the folder it's installed in>
# The app quits right after, so the installer waits for it, skips its pages and starts the new
# version when it's done.
Var updating

# The version information for this two must consist of 4 parts
VIProductVersion "${INFO_PRODUCTVERSION}.0"
VIFileVersion    "${INFO_PRODUCTVERSION}.0"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} Installer"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

# Enable HiDPI support. https://nsis.sourceforge.io/Reference/ManifestDPIAware
ManifestDPIAware true

!include "MUI.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
!define MUI_ABORTWARNING # This will warn the user if they exit from the installer.
!define MUI_FINISHPAGE_RUN "$INSTDIR\${PRODUCT_EXECUTABLE}"
!define MUI_FINISHPAGE_RUN_TEXT "Start ${INFO_PRODUCTNAME}"

!define MUI_PAGE_CUSTOMFUNCTION_PRE skipWhenUpdating
!insertmacro MUI_PAGE_WELCOME
!define MUI_PAGE_CUSTOMFUNCTION_PRE skipWhenUpdating
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_PAGE_CUSTOMFUNCTION_PRE skipWhenUpdating
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

## The following two statements can be used to sign the installer and the uninstaller. The path to the binaries are provided in %1
#!uninstfinalize 'signtool --file "%1"'
#!finalize 'signtool --file "%1"'

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\bin\${INFO_PROJECTNAME}-Setup.exe"
InstallDir "$LOCALAPPDATA\Programs\${INFO_PRODUCTNAME}"
ShowInstDetails show
ShowUninstDetails show

# The commands the app registers for itself (internal/sys/registry_windows.go, background.go).
# The uninstaller removes them only when they point at this copy, so a portable copy elsewhere
# keeps its links.
!define LINK_KEY "Software\Classes\prem-dl"
!define RUN_KEY  "Software\Microsoft\Windows\CurrentVersion\Run"

Function .onInit
   !insertmacro wails.checkArchitecture
   ${GetParameters} $0
   ClearErrors
   ${GetOptions} $0 "/update" $1
   ${IfNot} ${Errors}
       StrCpy $updating "1"
   ${EndIf}
FunctionEnd

Function skipWhenUpdating
    ${If} $updating == "1"
        Abort
    ${EndIf}
FunctionEnd

# A running copy holds its exe open, so it can't be replaced or removed. It may only be in the tray.
!macro CLOSE_APP UN
Function ${UN}closeApp
    StrCpy $1 0
    retry:
    IfFileExists "$INSTDIR\${PRODUCT_EXECUTABLE}" 0 done
    ClearErrors
    FileOpen $0 "$INSTDIR\${PRODUCT_EXECUTABLE}" a
    IfErrors 0 opened
        # An updating app quits just after starting the installer: give it half a minute.
        ${If} $updating == "1"
        ${AndIf} $1 < 60
            IntOp $1 $1 + 1
            Sleep 500
            Goto retry
        ${EndIf}
        MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "${INFO_PRODUCTNAME} is running. Quit it first: right-click its icon in the notification area and choose Quit ${INFO_PRODUCTNAME}. Then click Retry." /SD IDCANCEL IDRETRY retry
        Abort
    opened:
    FileClose $0
    done:
FunctionEnd
!macroend
!insertmacro CLOSE_APP ""
!insertmacro CLOSE_APP "un."

Section
    !insertmacro wails.setShellContext
    Call closeApp

    !insertmacro wails.webview2runtime

    SetOutPath $INSTDIR

    !insertmacro wails.files

    CreateShortcut "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    # An update leaves the desktop as it is: the user may have deleted the shortcut.
    ${If} $updating != "1"
        CreateShortCut "$DESKTOP\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    ${EndIf}

    !insertmacro wails.associateFiles
    !insertmacro wails.associateCustomProtocols

    !insertmacro wails.writeUninstaller

    ${If} $updating == "1"
        SetAutoClose true
        Exec '"$INSTDIR\${PRODUCT_EXECUTABLE}"'
    ${EndIf}
SectionEnd

Section "uninstall"
    !insertmacro wails.setShellContext
    Call un.closeApp

    ReadRegStr $0 HKCU "${LINK_KEY}\shell\open\command" ""
    ${If} $0 == '"$INSTDIR\${PRODUCT_EXECUTABLE}" "%1"'
        DeleteRegKey HKCU "${LINK_KEY}"
    ${EndIf}
    ReadRegStr $0 HKCU "${RUN_KEY}" "${INFO_PRODUCTNAME}"
    ${If} $0 == '"$INSTDIR\${PRODUCT_EXECUTABLE}" --background'
        DeleteRegValue HKCU "${RUN_KEY}" "${INFO_PRODUCTNAME}"
    ${EndIf}

    RMDir /r "$AppData\${PRODUCT_EXECUTABLE}" # Remove the WebView2 DataPath

    RMDir /r $INSTDIR

    Delete "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk"
    Delete "$DESKTOP\${INFO_PRODUCTNAME}.lnk"

    !insertmacro wails.unassociateFiles
    !insertmacro wails.unassociateCustomProtocols

    !insertmacro wails.deleteUninstaller

    # The data folder kept the app's old name, yt-dlp-gui. Kept by default, and in a silent uninstall.
    MessageBox MB_YESNO|MB_DEFBUTTON2|MB_ICONQUESTION "Also remove your ${INFO_PRODUCTNAME} settings, queue and followed channels, and its copies of yt-dlp and ffmpeg?$\n$\nYour downloaded videos are not touched." /SD IDNO IDNO keepData
        RMDir /r "$AppData\yt-dlp-gui"
    keepData:
SectionEnd
