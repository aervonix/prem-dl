build/bin
node_modules
frontend/dist
/yt-dlp.exe
/yt-dlp
/yt-dlp.d/
*.exe~
# tools for a bundled build, fetched by go run ./cmd/bundle
/bundle/
# release files from scripts/release.ps1, and the WebView2 bootstrapper wails -nsis downloads
/build/release/
/build/tools/
/build/windows/installer/tmp/
# the build secret of a release build (cmd/buildsecret writes it, the release scripts delete it)
/internal/selfupdate/secret_release.go
/internal/selfupdate/target_release.go
# Windows tools fetched on Linux (release-windows.sh), and this machine's while they are swapped out
/build/bundle-windows/
/build/bundle-host/
# release notes drafted for a release
/build/notes/
# notes for coding agents: kept on this machine, not published
/CLAUDE.md
# Wails's own fingerprint of package.json (decides whether to run npm install); differs per machine
/frontend/package.json.md5
