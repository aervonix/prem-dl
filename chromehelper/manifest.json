{
  "manifest_version": 3,
  "name": "Prem-dl helper",
  "version": "1.1.0",
  "description": "Sends pages and links to Prem-dl from the toolbar and the right-click menu, and hands it your YouTube cookies when you approve it.",
  "key": "",
  "permissions": ["cookies", "contextMenus", "activeTab"],
  "optional_host_permissions": ["https://*.youtube.com/*"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Download with Prem-dl",
    "default_icon": {"16": "icon16.png", "32": "icon32.png"}
  },
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}
}
