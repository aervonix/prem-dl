{
  "manifest_version": 3,
  "name": "Prem-dl cookie helper",
  "version": "1.0.0",
  "description": "Hands your YouTube cookies to Prem-dl when you approve it, so downloads can use your account (Premium quality, age-restricted videos).",
  "key": "",
  "permissions": ["cookies"],
  "optional_host_permissions": ["https://*.youtube.com/*"],
  "host_permissions": ["http://127.0.0.1/*"]
}
